{
  "_comment": "Copy to config/dev.local.json and fill secrets. dev.local.json is gitignored. OData /fmi/odata/v4/{db} is case-sensitive; use the exact name from GET /fmi/odata/v4 on the host. Per table, fieldOverrides lists extra fields to sync (e.g. calculated); otherwise only non-calculated fields from $metadata are synced.",
  "servers": [
    {
      "id": "blue",
      "url": "https://your-host.example/fmi/odata/v4/YourDatabaseBlue",
      "username": "filemaker_account",
      "password": "use-env-or-local-file-not-git"
    },
    {
      "id": "green",
      "url": "https://your-host.example/fmi/odata/v4/YourDatabaseGreen",
      "username": "filemaker_account",
      "password": "use-env-or-local-file-not-git"
    }
  ],
  "tables": [
    {
      "name": "People",
      "primaryKey": "id",
      "modifiedField": "ModificationTimestamp",
      "fieldOverrides": []
    }
  ],
  "defaults": {
    "primaryKey": "id",
    "modifiedField": "ModificationTimestamp"
  },
  "overlapMinutes": 10,
  "initialLookback": "1d",
  "maxLookback": "90d",
  "bootstrapMode": "fixed",
  "schemaMode": "intersection",
  "batchSize": 50,
  "maxWorkers": 8,
  "verifyMode": "off"
}
