# Copy to `.env` and fill in. Never commit `.env`.

# Blue (current production file)
FM_BLUE_BASE_URL=https://filemaker.internal.example/fmi/data/vLatest
FM_BLUE_DATABASE=YourSolutionBlue
FM_BLUE_USER=api_blue
FM_BLUE_PASSWORD=

# Green (standby / next version file)
FM_GREEN_BASE_URL=https://filemaker.internal.example/fmi/data/vLatest
FM_GREEN_DATABASE=YourSolutionGreen
FM_GREEN_USER=api_green
FM_GREEN_PASSWORD=

# Seconds between sync cycles; 0 = run once and exit
SYNC_INTERVAL_SEC=300

LOG_LEVEL=INFO
